# Copy to .env and fill in. .env is gitignored and must never be committed.

# PostgreSQL with pgvector. Local compose binds 127.0.0.1:15441 so it cannot collide with the
# other repositories in this workspace. Managed providers hand out postgres:// or postgresql://;
# both are normalised to postgresql+psycopg:// by store.engine.
WCR_DATABASE_URL=postgresql+psycopg://warranty:warranty_local_only@127.0.0.1:15441/warranty_claim_recovery

# Redis. Load-bearing: the case work queue, its leases, and submission idempotency state.
WCR_REDIS_URL=redis://127.0.0.1:16380/0

# The approver token that the human-in-the-loop gate requires. NO DEFAULT, deliberately: a
# deployment without it can approve nothing, which is the safe direction.
WCR_APPROVER_TOKEN=

# The abstractive correction arm. NO DEFAULT. Without it the live arm raises rather than
# returning a stub, and no cost, latency or quality figure is published for it.
WCR_LLM_API_KEY=

# Read-only public demo: refuse every mutating route.
WCR_READ_ONLY=true
WCR_ENVIRONMENT=local
